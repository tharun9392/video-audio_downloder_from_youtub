/* Stylesheet for YT Grabber */

QWidget#mainWindow {
    background-color: #0f1016; /* Deep blackish violet background */
}

QFrame#sidebarFrame {
    background-color: #161824; /* Card background */
    border: 1px solid #202336;
    border-radius: 12px;
}

QWidget#mainPanel {
    background-color: #0f1016;
}

/* Sidebar Title Items */
QLabel#sidebarTitle {
    font-size: 20px;
    font-weight: 800;
    color: #ffffff;
}

QLabel#sidebarSub {
    font-size: 11.5px;
    color: #94a3b8;
}

QLabel#logoLabel {
    background-color: #ef4444; /* YouTube red logo */
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
    border-radius: 8px;
}

/* Section labels */
QLabel#sectionLabel1, QLabel#sectionLabel2, QLabel#sectionLabel3, QLabel#urlLabel, QLabel#statusHeader {
    font-size: 12px;
    font-weight: 600;
    color: #94a3b8; /* Slate gray */
}

QLineEdit {
    background-color: #1f2130;
    border: 1px solid #2d3148;
    border-radius: 8px;
    padding: 10px 14px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 400;
}

QLineEdit:focus {
    border: 1.5px solid #3b82f6; /* Blue focus outline */
}

QLineEdit::placeholder {
    color: #64748b;
}

QLineEdit#urlInput {
    font-size: 14px;
    background-color: #1f2130;
    border: 1px solid #2d3148;
}

/* Custom styled QRadioButtons as rows */
QRadioButton {
    spacing: 12px;
    font-weight: 600;
    color: #ffffff;
    padding: 12px 14px;
    border-radius: 8px;
    background-color: #1f2130;
    border: 1px solid #2d3148;
}

QRadioButton:hover {
    background-color: #26293c;
    border-color: #3b82f6;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 9px;
    border: 2px solid #475569;
    background-color: #1f2130;
}

/* Specially style check borders and inner circle of radio */
QRadioButton#radioVideo:checked {
    background-color: #15223a;
    border: 2px solid #3b82f6;
}

QRadioButton#radioVideo::indicator:checked {
    border: 5px solid #3b82f6;
    background-color: #ffffff;
}

QRadioButton#radioAudio:checked {
    background-color: #211637;
    border: 2px solid #a855f7;
}

QRadioButton#radioAudio::indicator:checked {
    border: 5px solid #a855f7;
    background-color: #ffffff;
}

/* ComboBox Styles */
QComboBox {
    background-color: #1f2130;
    border: 1px solid #2d3148;
    border-radius: 8px;
    padding: 10px 14px;
    color: #ffffff;
}

QComboBox:disabled {
    background-color: #161824;
    border: 1px solid #1f2130;
    color: #475569;
}

QComboBox::drop-down {
    border: 0px;
    width: 25px;
}

QComboBox::down-arrow {
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #cbd5e1;
    width: 0;
    height: 0;
    margin-right: 12px;
}

QComboBox QAbstractItemView {
    background-color: #1f2130;
    border: 1px solid #2d3148;
    selection-background-color: #3b82f6;
    color: #ffffff;
}

/* QFrames right content */
QFrame#urlCard, QFrame#previewCard, QFrame#statusCard {
    background-color: #161824;
    border: 1px solid #202336;
    border-radius: 12px;
}

QPushButton {
    background-color: #1f2130;
    color: #ffffff;
    font-weight: 600;
    border: 1px solid #2d3148;
    border-radius: 8px;
    padding: 10px 18px;
}

QPushButton:hover {
    background-color: #26293c;
}

QPushButton#folderBtn {
    background-color: #1f2130;
    color: #ffffff;
    font-size: 13px;
}

QPushButton#folderBtn:hover {
    border-color: #3b82f6;
}

QPushButton#pasteBtn {
    background-color: #3b82f6; /* Blue button */
    border: none;
    color: #ffffff;
    font-weight: bold;
    padding: 10px 20px;
}

QPushButton#pasteBtn:hover {
    background-color: #2563eb;
}

QPushButton#downloadBtn {
    background-color: #8b5cf6; /* Purple button */
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
    padding: 14px 28px;
    border: none;
    border-radius: 8px;
}

QPushButton#downloadBtn:hover {
    background-color: #7c3aed;
}

QPushButton#openFolderBtn {
    background-color: #10b981;
    color: white;
    font-size: 15px;
    font-weight: bold;
    padding: 14px 28px;
    border: none;
    border-radius: 8px;
}

QPushButton#openFolderBtn:hover {
    background-color: #059669;
}

/* Thumbnail placeholder and layout */
QLabel#previewThumbnail {
    background-color: #251c1c; /* Dark reddish brown background */
    border: 1.5px solid #2a1f1f;
    border-radius: 8px;
}

QLabel#previewTitle {
    font-size: 15px;
    font-weight: bold;
    color: #ffffff;
}

QLabel#previewDetails {
    font-size: 12.5px;
    color: #94a3b8;
}

/* Status Pill Capsule */
QLabel#statusPercentage {
    background-color: #064e3b; /* Dark green background */
    color: #34d399; /* Green text */
    font-weight: bold;
    font-size: 12px;
    border-radius: 10px;
    padding: 2px 10px;
}

QLabel#statusLabel {
    font-size: 16px;
    font-weight: bold;
    color: #ffffff;
}

QProgressBar {
    border: none;
    background-color: #1f2130;
    border-radius: 3px;
}

QProgressBar::chunk {
    background-color: #8b5cf6;
    border-radius: 3px;
}
